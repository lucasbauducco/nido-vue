@import 'line-awesome/dist/line-awesome/css/line-awesome.css'
@import 'nib'
    
normalize-css()
*
    box-sizing  border-box
@import 'classes'
@import 'forms'
    html
        height 100%  
    body
        font-family var(--font-body)
        font-size 18px
        line-height 1.45
        height 100%
        background var(--bg)
        color var(--ink)
    a
        color var(--accent)
        font-weight 700
        text-decoration none
    #app 
        height 100%
    header
        position fixed
        top 0
        left 0
        width 100%
        display flex
        align-items center
        z-index 100
        background var(--surface)
        border-bottom 1px solid var(--line)
        nav 
            width 100%
            div.column:nth-child(1)
                display flex
                flex-basis 50%
                align-items center
                input 
                    margin 0
            div.flex
                justify-content space-between
            img
                width 100px
            div.logo
                width 24px
                height 24px
                background transparent
                margin-right 120px
                display inline-block
                a   
                    color var(--ink)
                    font-weight normal
                    background none
            form 
                flex-grow 1
                div.search-box
                    position relative
                    svg 
                        position absolute
                        left 10px
                        transform translate(0, 50%)
                    input 
                        padding-left 50px
                        &::placeholder
                            color var(--muted)
                        
            a[tag="button"]
                flex-basis 180px
            ul.user-actions
                margin 0
                padding 0
                li 
                    display inline-block
                    list-style none
                    a
                        font-size 32px
                        color var(--ink)
                        margin-left 10px


    h1 
        font-family var(--font-display)
        font-weight 600
        font-size 34px
        letter-spacing -0.02em
    