input[type="text"]
input[type="password"]
input[type="email"]
input[type="submit"]
    height 45px
    background-color var(--surface-2)
    color var(--ink)
    font-family var(--font-body)
    font-size 17px
    border none
    outline none
    border-radius 23px
    padding 0 20px
    margin-bottom 10px
    width 100%
    font-weight 600
input[type="submit"]
    padding 0
    background-color var(--accent)
    color var(--accent-ink)
    font-family var(--font-display)
    font-size 15px
    font-weight 700
button, a[tag="button"]
    height 50px
    border-radius 23px
    padding 15px 30px
    border none
    outline none
    width 100%
    background-color var(--accent)
    color var(--accent-ink)
    font-family var(--font-display)
    font-size 15px
    font-weight 700
textarea
    background-color var(--surface-2)
    color var(--ink)
    font-family var(--font-body)
    font-size 17px
    border none
    outline none
    border-radius 23px
    padding 20px
    margin-bottom 10px
    width 100%
    font-weight 600
    resize vertical
    
